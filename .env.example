# Copy to .env and fill in. Never commit .env.
# Generate a key: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

DB_NAME=omnios_db
DB_USER=omnios_user
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

CORS_ALLOWED_ORIGINS=https://localhost
CSRF_TRUSTED_ORIGINS=https://localhost
NUM_PROXIES=1
SECURE_SSL_REDIRECT=True

# First Super Admin, created on first start (leave empty if you will use seed_demo).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
